@app.post("/generate-comic/json")

def generate_json(

    prompt: str,

    character: str,

    setting: str,

    tone: str = "adventure",

    panels: int = 4

):

    outline = generate_outline(

        prompt,
        character,
        setting,
        tone,
        panels

    )


    story = generate_story(

        prompt,
        character,
        setting,
        tone,
        outline

    )


    return {

        "success": True,

        "title": story.get(
            "title",
            "ComicCraft"
        ),

        "outline": outline,

        "story": story

    }


