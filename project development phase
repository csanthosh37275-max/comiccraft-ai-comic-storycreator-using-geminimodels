# ============================================================
# GEMINI FLASH
# OUTLINE GENERATION
# ============================================================

def generate_outline(
    prompt: str,
    character: str,
    setting: str,
    tone: str,
    panels: int
):

    if client is None:

        raise Exception(
            "Gemini API key is missing. "
            "Add your API key in GEMINI_API_KEY."
        )


    instruction = f"""

You are an expert comic story planner.

Create an outline for an AI-generated comic.

Story idea:
{prompt}

Main character:
{character}

Setting:
{setting}

Tone:
{tone}

Number of panels:
{panels}

Return ONLY valid JSON.

Use exactly this structure:

{{
    "title": "Comic title",
    "panels": [
        {{
            "panel_number": 1,
            "scene": "Description of the scene",
            "action": "What happens",
            "emotion": "Character emotion"
        }}
    ]
}}

Create exactly {panels} panels.

"""


    response = client.models.generate_content(

        model=FLASH_MODEL,

        contents=instruction,

        config=types.GenerateContentConfig(

            temperature=0.8,

            response_mime_type="application/json"

        )

    )


    text = response.text.strip()

    try:

        data = json.loads(text)

    except json.JSONDecodeError:

        start = text.find("{")

        end = text.rfind("}")

        if start == -1 or end == -1:

            raise Exception(
                "Gemini returned invalid JSON."
            )

        data = json.loads(
            text[start:end + 1]
        )


    return data


# ============================================================
# GEMINI PRO
# STORY GENERATION
# ============================================================

def generate_story(
    prompt: str,
    character: str,
    setting: str,
    tone: str,
    outline: dict
):

    if client is None:

        raise Exception(
            "Gemini API key is missing."
        )


    instruction = f"""

You are an expert comic book writer.

Create a complete comic story using the outline below.

Original idea:
{prompt}

Main character:
{character}

Setting:
{setting}

Tone:
{tone}

Outline:
{json.dumps(outline, indent=2)}

Return ONLY valid JSON.

Use exactly this structure:

{{
    "title": "Comic title",
    "panels": [
        {{
            "panel_number": 1,
            "scene": "Detailed visual description",
            "caption": "Short comic caption",
            "narration": "Narrator text",
            "dialogue": [
                "Character: Dialogue"
            ],
            "emotion": "Emotion"
        }}
    ]
}}

Keep the dialogue short and natural.

Create one story panel for every outline panel.

"""


    response = client.models.generate_content(

        model=PRO_MODEL,

        contents=instruction,

        config=types.GenerateContentConfig(

            temperature=0.9,

            response_mime_type="application/json"

        )

    )


    text = response.text.strip()


    try:

        data = json.loads(text)

    except json.JSONDecodeError:

        start = text.find("{")

        end = text.rfind("}")

        if start == -1 or end == -1:

            raise Exception(
                "Gemini returned invalid story JSON."
            )

        data = json.loads(
            text[start:end + 1]
        )


    return data


